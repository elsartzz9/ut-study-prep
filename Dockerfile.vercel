# Optional Vercel Container Runtime deployment.
# Streamlit Community Cloud is the recommended host; see README.md for tradeoffs.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 80
CMD ["streamlit", "run", "app.py", "--server.address=0.0.0.0", "--server.port=80", "--server.headless=true"]
